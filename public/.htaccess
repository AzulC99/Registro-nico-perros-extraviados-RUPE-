# ============================================================
# RUPE CDMX — public/.htaccess
# Front Controller · HTTPS · seguridad · caché · compresión
# Document root = esta carpeta (public/)
# Hostinger · Apache 2.4 · PHP 8.3.33
# ============================================================

RewriteEngine On
RewriteBase /

# --- Forzar HTTPS (Hostinger / proxy CF) ---
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Bloquear archivos ocultos y backups ---
RewriteRule "(^|/)\." - [F,L]
RewriteRule \.(bak|sql|log|md| Dist|ini|sh|yml|yaml|env|old|swp)$ - [F,L]

# --- No reescribir archivos/directorios reales ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# --- Seguridad HTTP ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    # HSTS (solo si HTTPS está estable)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # No revelar PHP
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# --- PHP 8.3.33 Hostinger (mod_php / CGI según plan) ---
<IfModule mod_php.c>
    php_value display_errors 0
    php_value log_errors 1
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value memory_limit 256M
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
</IfModule>
<IfModule mod_php8.c>
    php_value display_errors 0
    php_value log_errors 1
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value memory_limit 256M
</IfModule>

# --- Caché estáticos ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

AddDefaultCharset UTF-8
DirectoryIndex index.php

# Sin listado
Options -Indexes -MultiViews
